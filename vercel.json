{
  "routes": [
    {
      "src": "^/$",
      "has": [{ "type": "host", "value": "roadwright.baselashraf.com" }],
      "dest": "/roadwright/"
    },
    {
      "src": "^/(?!roadwright/)(.*)$",
      "has": [{ "type": "host", "value": "roadwright.baselashraf.com" }],
      "dest": "/roadwright/$1"
    },
    {
      "src": "^/roadwright/?$",
      "status": 301,
      "headers": { "Location": "https://roadwright.baselashraf.com/" }
    },

    {
      "src": "^/$",
      "has": [{ "type": "host", "value": "winduo.baselashraf.com" }],
      "dest": "/winduo/"
    },
    {
      "src": "^/(?!winduo/)(.*)$",
      "has": [{ "type": "host", "value": "winduo.baselashraf.com" }],
      "dest": "/winduo/$1"
    },
    {
      "src": "^/winduo/?$",
      "status": 301,
      "headers": { "Location": "https://winduo.baselashraf.com/" }
    },

    { "handle": "filesystem" }
  ]
}
