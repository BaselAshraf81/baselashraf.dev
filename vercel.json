{
  "routes": [
    {
      "src": "^/(.*)$",
      "has": [{ "type": "host", "value": "roadwright.baselashraf.com" }],
      "status": 301,
      "headers": { "Location": "https://baselashraf.com/roadwright/$1" }
    },
    {
      "src": "^/(.*)$",
      "has": [{ "type": "host", "value": "winduo.baselashraf.com" }],
      "status": 301,
      "headers": { "Location": "https://baselashraf.com/winduo/$1" }
    },
    {
      "src": "^/(.*)$",
      "has": [{ "type": "host", "value": "sensortap.baselashraf.com" }],
      "status": 301,
      "headers": { "Location": "https://baselashraf.com/sensortap/$1" }
    },
    { "handle": "filesystem" }
  ]
}
